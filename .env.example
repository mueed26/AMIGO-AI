# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Serverless Postgres Database (Drizzle ORM)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-placeholder-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Gemini (agent planning / config generation)
GOOGLE_CLOUD_GEMINI_API_KEY=

# Composio (tool integrations, e.g. Gmail, Slack, calendars)
COMPOSIO_API_KEY=

# OpenAI Agents SDK (agent execution model)
OPENAI_MODEL=gpt-4o-mini

# Browserbase (live web research tool)
BROWSERBASE_API_KEY=
BROWSERBASE_AGENT_ID=

#for development, for production you need event key and signing key 
INNGEST_DEV=1
#injjest for bacground jobs 